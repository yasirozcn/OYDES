# Kopyalayın: cp .env.example .env.local   (.env.local git'e GİRMEZ)

# ---------------------------------------------------------------- ortak geliştirme veritabanı (AWS)
# Herkes aynı AWS veritabanına bağlanır; yerelde veritabanı kurulmaz.
# Adres ve şifreyi proje sahibi özel kanaldan verir. Şifreyi buraya değil .env.local'e yazın.
#   postgres://izmirfen_app:<ŞİFRE>@<SUNUCU_IP>:5433/izmirfen
DATABASE_URL=
# Sunucu yalnızca şifreli (SSL) bağlantı kabul eder. Sertifika kendinden imzalı olduğu için doğrulama kapalı.
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
# Ortak veritabanında bağlantı sayısı sınırlı: geliştirici başına küçük havuz.
DATABASE_POOL_MAX=3

# Yalnızca proje sahibi (şema değişikliği için; ekipte BOŞ kalır):
# DATABASE_OWNER_URL=postgres://izmirfen_owner:<ŞİFRE>@<SUNUCU_IP>:5433/izmirfen

# ---------------------------------------------------------------- uygulama
# JWT imzalama anahtarı: her geliştirici KENDİSİ üretir (openssl rand -hex 32), kimseyle paylaşmaz.
# Boşsa geliştirmede sabit geliştirme anahtarı kullanılır; canlıda (NODE_ENV=production) boşsa token üretilmez/doğrulanmaz.
# Canlı sunucunun anahtarı ayrıdır ve yalnızca sunucuda durur. Kurallar: kök AGENTS.md §5.1
AUTH_SECRET=
BLE_REQUIRED=false
DUPLICATE_WINDOW_SECONDS=120
# Veli WhatsApp bildirimi. mock: gerçek mesaj gitmez (geliştirmede böyle kalmalı — veritabanı ortak).
# insider: Insider API'siyle gerçek gönderim. INSIDER_API_KEY gizlidir: yalnızca kendi .env dosyanıza yazın,
# kimseyle paylaşmayın, commit'lemeyin. NEXT_PUBLIC_ öneki ASLA eklenmez (eklenirse tarayıcıya gider).
WHATSAPP_PROVIDER=mock
INSIDER_API_KEY=
WHATSAPP_TEMPLATE=utility_template_deneme
# Yerelde http üzerinden çalışırken false
COOKIE_SECURE=false
