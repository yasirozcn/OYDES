# Kopyalayın: cp .env.example .env   (bu dosya git'e girmez; içeriğini kimseyle paylaşmayın)

# Sunucunun adresi. Alan adınız yoksa Lightsail statik IP'sinden üretin:
#   IP 3.121.45.67 ise → 3-121-45-67.sslip.io
DOMAIN=

# Üretin: openssl rand -hex 32   (geliştiricilerin yerel anahtarlarından FARKLI olmalı; değişirse tüm oturumlar düşer)
AUTH_SECRET=

# Aynı sunucudaki veritabanı (konteyner adı "db", iç port 5432). <APP_PASSWORD>: ~/izmirfen/infra/dev-db/.env içindeki değer.
DATABASE_URL=postgres://izmirfen_app:<APP_PASSWORD>@db:5432/izmirfen

# true: okutmada kiosk Bluetooth jetonu zorunlu
BLE_REQUIRED=false
# Veli WhatsApp bildirimi. mock: gerçek mesaj gitmez (geliştirmede böyle kalmalı — veritabanı ortak).
# insider: Insider API'siyle gerçek gönderim. INSIDER_API_KEY gizlidir: yalnızca kendi .env dosyanıza yazın,
# kimseyle paylaşmayın, commit'lemeyin. NEXT_PUBLIC_ öneki ASLA eklenmez (eklenirse tarayıcıya gider).
WHATSAPP_PROVIDER=mock
INSIDER_API_KEY=
WHATSAPP_TEMPLATE=utility_template_deneme
